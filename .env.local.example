# Copiar a .env.local — desarrollo en máquina (Docker + storage local)
# cp .env.local.example .env.local

PORT=3000
NODE_ENV=development

DATABASE_URL=postgresql://nolv:nolv@localhost:5432/nolv

JWT_SECRET=your-dev-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d

RECAPTCHA_SECRET_KEY=your-recaptcha-secret

RESEND_API_KEY=your-resend-api-key
RESEND_FROM=equipo@yourdomain.com
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

CORS_ORIGIN=http://localhost:4200
APP_PUBLIC_URL=http://localhost:4200

CRON_SECRET=local-dev-cron-secret-min-32-chars

LOG_LEVEL=debug

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-sb-secret-or-service-role-key
SUPABASE_STORAGE_BUCKET=items

STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage
