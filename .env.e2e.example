APP_ENV=e2e
NODE_ENV=development
E2E_ENABLED=true
E2E_SECRET=local-e2e-secret-min-32-characters-long
DATABASE_URL=postgresql://nolv:nolv@localhost:5432/nolv_e2e
CORS_ORIGIN=http://localhost:4201
APP_PUBLIC_URL=http://localhost:4201
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage-e2e
LOG_LEVEL=warn
JWT_SECRET=local-jwt-secret-min-32-characters-long
RECAPTCHA_SECRET_KEY=dev-mock-recaptcha
RESEND_API_KEY=re_dev_mock_key
RESEND_FROM=e2e@test.local
SUPABASE_URL=https://placeholder.supabase.co
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key-min-32-chars
SUPABASE_STORAGE_BUCKET=placeholder
CRON_SECRET=local-cron-secret-min-32-characters-long
