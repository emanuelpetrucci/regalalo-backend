{
  "name": "regalalo-backend",
  "version": "1.5.0",
  "license": "AGPL-3.0-or-later",
  "description": "Backend para Regálalo",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "dev:remote": "cross-env APP_ENV=dev tsx watch src/main.ts",
    "dev:remote:prod": "cross-env APP_ENV=prod tsx watch src/main.ts",
    "build": "npm run openapi:generate && tsc",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "start": "node dist/main.js",
    "start:dev": "cross-env APP_ENV=dev node dist/main.js",
    "start:prod": "cross-env APP_ENV=prod node dist/main.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:dev": "cross-env APP_ENV=dev tsx scripts/migrate.ts",
    "db:migrate:prod": "cross-env APP_ENV=prod tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:dev": "cross-env APP_ENV=dev tsx scripts/seed.ts",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:backup:dev": "cross-env APP_ENV=dev tsx scripts/db-backup.ts",
    "db:backup:prod": "cross-env APP_ENV=prod tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "db:restore:dev": "cross-env APP_ENV=dev tsx scripts/db-restore.ts",
    "db:restore:prod": "cross-env APP_ENV=prod tsx scripts/db-restore.ts",
    "storage:backup": "tsx scripts/storage-backup.ts",
    "storage:backup:dev": "cross-env APP_ENV=dev tsx scripts/storage-backup.ts",
    "storage:backup:prod": "cross-env APP_ENV=prod tsx scripts/storage-backup.ts",
    "backfill:location-names": "tsx scripts/backfill-location-names.ts",
    "backfill:location-names:dev": "cross-env APP_ENV=dev tsx scripts/backfill-location-names.ts",
    "backfill:location-names:prod": "cross-env APP_ENV=prod tsx scripts/backfill-location-names.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "admin:create:dev": "cross-env APP_ENV=dev tsx scripts/create-admin.ts",
    "dev:e2e": "cross-env APP_ENV=e2e tsx watch src/main.ts",
    "e2e:db:create": "cross-env APP_ENV=e2e tsx scripts/e2e-db.ts create",
    "e2e:db:migrate": "cross-env APP_ENV=e2e tsx scripts/e2e-db.ts migrate",
    "e2e:db:purge": "cross-env APP_ENV=e2e tsx scripts/e2e-db.ts purge",
    "e2e:db:recreate": "cross-env APP_ENV=e2e tsx scripts/e2e-db.ts recreate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "@supabase/supabase-js": "^2.119.2",
    "argon2": "^0.44.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "express": "^4.22.3",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.3.5",
    "multer": "^2.5.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "resend": "^6.12.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^6.0.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.1.1",
    "cross-env": "^10.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^2.1.0"
  }
}
