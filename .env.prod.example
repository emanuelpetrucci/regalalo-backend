# Copiar a .env.prod — producción (o definir las mismas vars en el hosting)
# cp .env.prod.example .env.prod

PORT=3000
NODE_ENV=production

DATABASE_URL=postgresql://postgres:PASSWORD_URL_ENCODED@db.your-project.supabase.co:5432/postgres

JWT_SECRET=your-production-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d

RECAPTCHA_SECRET_KEY=your-production-recaptcha-secret

RESEND_API_KEY=your-resend-api-key
RESEND_FROM=equipo@yourdomain.com
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

CORS_ORIGIN=https://regalalo.org
CORS_EXTRA_ORIGINS=https://www.regalalo.org
# Preview deployments del frontend en Vercel (obligatorio si API_URL apunta a prod)
CORS_ALLOW_VERCEL_PREVIEWS=false
APP_PUBLIC_URL=https://regalalo.org

# Cron externo digest EVT-015 — openssl rand -hex 32
CRON_SECRET=your-production-cron-secret-min-32-chars

LOG_LEVEL=info
LOG_FILE=logs/app.log
# Producción: persistencia AE en Postgres (default si se omite)
ANALYTICS_PERSISTENCE=postgres

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-sb-secret-or-service-role-key
SUPABASE_STORAGE_BUCKET=items

STORAGE_DRIVER=supabase
LOCAL_STORAGE_DIR=.storage
