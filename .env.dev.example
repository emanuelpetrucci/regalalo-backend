# Copiar a .env.dev — entorno DEV remoto (Supabase DB + Storage)
# cp .env.dev.example .env.dev

PORT=3000
NODE_ENV=development

# Dashboard → Database → Connection string (codificar # & ! + en la contraseña)
DATABASE_URL=postgresql://postgres:PASSWORD_URL_ENCODED@db.your-project.supabase.co:5432/postgres

JWT_SECRET=your-dev-jwt-secret-min-32-chars
JWT_EXPIRES_IN=7d

RECAPTCHA_SECRET_KEY=your-recaptcha-secret
# Opcional. Desarrollo: 0.3 recomendado (incógnito). Producción: omitir (default 0.5).
# RECAPTCHA_MIN_SCORE=0.3

RESEND_API_KEY=your-resend-api-key
RESEND_FROM=equipo@yourdomain.com
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

CORS_ORIGIN=http://localhost:4200
# Orígenes adicionales separados por coma (p. ej. puerto Angular local)
CORS_EXTRA_ORIGINS=http://localhost:4201
# Preview deployments en Vercel (*.vercel.app). Default: true en dev, false en prod
CORS_ALLOW_VERCEL_PREVIEWS=true
APP_PUBLIC_URL=http://localhost:4200

# Cron externo (cron-job.org) — header X-Cron-Secret; mín. 32 caracteres
CRON_SECRET=openssl-rand-hex-32-replace-me

LOG_LEVEL=info
LOG_FILE=logs/app.log
# Persistencia de eventos AE en Postgres (stdout si se omite en dev)
ANALYTICS_PERSISTENCE=postgres

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-sb-secret-or-service-role-key
SUPABASE_STORAGE_BUCKET=items

STORAGE_DRIVER=supabase
LOCAL_STORAGE_DIR=.storage
