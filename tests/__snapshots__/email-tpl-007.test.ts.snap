exports[`email-tpl-007 — degradación por inactividad > 9.4 — snapshot de TPL-007 1`] = `
"<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
