  <!-- Outer wrapper -->
  <table width="100%" cellpadding="0" cellspacing="0" border="0" role="presentation"
    style="background-color: #F4F5F6;">
    <tr>
      <td align="center" style="padding: 24px 16px;">

        <!-- Email container (max 600px) -->
        <table width="600" cellpadding="0" cellspacing="0" border="0" role="presentation"
          style="max-width: 600px; width: 100%; background-color: #FFFFFF; border-radius: 8px; border: 1px solid #D5D9DE;">

          <!-- Header -->
          <tr>
            <td style="background-color: #3A7358; border-radius: 8px 8px 0 0; padding: 24px; text-align: center;">
              <span style="font-family: 'Playfair Display', Georgia, serif; font-size: 22px; font-weight: 700; color: #FFFFFF; letter-spacing: -0.3px;">
                Regálalo
              </span>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding: 32px 40px 8px 40px;">

              <!-- Saludo -->
              <p style="font-family: 'DM Sans', Arial, Helvetica, sans-serif; font-size: 16px; color: #606A76; margin: 0 0 16px 0; padding: 0;">
                Hola, Lucía
              </p>

              <!-- Titular -->
              <h1 style="font-family: 'Playfair Display', Georgia, serif; font-size: 24px; font-weight: 700; color: #14171A; margin: 0 0 16px 0; padding: 0; line-height: 1.3;">Tu objeto aparece más abajo en el tablón</h1>

              <!-- Cuerpo -->
              <p style="font-family: 'DM Sans', Arial, Helvetica, sans-serif; font-size: 16px; line-height: 1.6; color: #606A76; margin: 0 0 16px 0; padding: 0;">Tu objeto «Silla de oficina» lleva más de 7 días publicado sin que se elija un receptor.</p><p style="font-family: 'DM Sans', Arial, Helvetica, sans-serif; font-size: 16px; line-height: 1.6; color: #606A76; margin: 0 0 16px 0; padding: 0;">Para dar visibilidad a publicaciones más recientes, aparece más abajo en el tablón.</p><p style="font-family: 'DM Sans', Arial, Helvetica, sans-serif; font-size: 16px; line-height: 1.6; color: #606A76; margin: 0 0 16px 0; padding: 0;">Si querés que lo vean más personas, podés actualizar la descripción o revisar el código postal.</p>

              <!-- CTA primario -->
              

              <!-- Fallback link -->
              

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding: 0 40px 24px 40px;">
              <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
  <tr>
    <td style="padding: 24px 0 0 0; border-top: 1px solid #D5D9DE; text-align: center;">
      <p style="font-family: 'DM Sans', Arial, Helvetica, sans-serif; font-size: 13px; color: #7C8692; margin: 0 0 8px 0; padding: 0;">
        ¿No creaste esta cuenta?
        <a href="mailto:soporte@regalalo.org" style="color: #3A7358; text-decoration: underline;">Contactá con soporte</a>
      </p>
      <p style="font-family: 'DM Sans', Arial, Helvetica, sans-serif; font-size: 12px; color: #7C8692; margin: 0; padding: 0;">
        © 2026 Regálalo. Todos los derechos reservados.
      </p>
    </td>
  </tr>
</table>
            </td>
          </tr>

