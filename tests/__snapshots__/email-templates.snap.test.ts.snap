            <td style="background-color: #3A7358; border-radius: 8px 8px 0 0; padding: 24px; text-align: center;">
              <span style="font-family: 'Playfair Display', Georgia, serif; font-size: 22px; font-weight: 700; color: #FFFFFF; letter-spacing: -0.3px;">
                Regálalo
              </span>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding: 32px 40px 8px 40px;">

              <!-- Saludo -->
              <p style="font-family: 'DM Sans', Arial, Helvetica, sans-serif; font-size: 16px; color: #606A76; margin: 0 0 16px 0; padding: 0;">
                Hola, María
              </p>

              <!-- Titular -->
              <h1 style="font-family: 'Playfair Display', Georgia, serif; font-size: 24px; font-weight: 700; color: #14171A; margin: 0 0 16px 0; padding: 0; line-height: 1.3;">Restablecé tu contraseña</h1>

              <!-- Cuerpo -->
              <p style="font-family: 'DM Sans', Arial, Helvetica, sans-serif; font-size: 16px; line-height: 1.6; color: #606A76; margin: 0 0 16px 0; padding: 0;">Recibimos una solicitud para restablecer la contraseña de tu cuenta.</p><p style="font-family: 'DM Sans', Arial, Helvetica, sans-serif; font-size: 16px; line-height: 1.6; color: #606A76; margin: 0 0 16px 0; padding: 0;">Este enlace vence en 60 minutos.</p>

              <!-- CTA primario -->
              <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
  <tr>
    <td align="center" style="padding: 24px 0 16px 0;">
      <a href="https://example.com/reset-password?token=xyz789" target="_blank"
        style="display: inline-block; background-color: #3A7358; color: #FFFFFF; font-family: 'DM Sans', Arial, Helvetica, sans-serif; font-size: 16px; font-weight: 600; line-height: 44px; min-height: 44px; padding: 0 32px; text-decoration: none; border-radius: 6px; mso-padding-alt: 0;">
        <!--[if mso]><i style="letter-spacing: 32px; mso-char-type: overhang;">&nbsp;</i><![endif]-->
        Restablecer contraseña
        <!--[if mso]><i style="letter-spacing: 32px; mso-char-type: overhang;">&nbsp;</i><![endif]-->
      </a>
    </td>
  </tr>
</table>

              <!-- Fallback link -->
              <p style="font-family: 'DM Sans', Arial, Helvetica, sans-serif; font-size: 14px; color: #7C8692; text-align: center; margin: 0 0 16px 0; padding: 0;">
        O copia este enlace: <a href="https://example.com/reset-password?token=xyz789" style="color: #3A7358; text-decoration: underline; word-break: break-all;">https://example.com/reset-password?token=xyz789</a>
      </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding: 0 40px 24px 40px;">
              <table width="100%" cellpadding="0" cellspacing="0" role="presentation">
  <tr>
    <td style="padding: 24px 0 0 0; border-top: 1px solid #D5D9DE; text-align: center;">
      <p style="font-family: 'DM Sans', Arial, Helvetica, sans-serif; font-size: 13px; color: #7C8692; margin: 0 0 8px 0; padding: 0;">
